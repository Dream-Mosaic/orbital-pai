# Copy to .env and fill in. dev.sh loads this.
GOOGLE_API_KEY=...      # Gemini (reflex + brain)
CARTESIA_API_KEY=...    # speech-to-text (Ink-2) + text-to-speech (Sonic)
PORT=8787               # dev server port
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VOYAGE_API_KEY=         # used for embedding/vectors

# Vector store (Unified Search / semantic memory). Local dev: run Qdrant via docker
# (`docker run -p 6333:6333 qdrant/qdrant:v1.18.2`) or the compose service.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=            # set the same value on the qdrant service in prod

# Instance timezone (IANA name) — grounds the assistant's relative-time reasoning and local-time
# display. Defaults to America/Chicago if unset; an invalid name falls back to that too.
TIMEZONE=America/Chicago

# Who can sign in (ordered JSON; first entry is the primary who owns pre-existing connections).
# `aliases` is optional — other Google addresses that map to the same person.
ALLOWED_USERS=[{"email":"you@example.com","name":"You","aliases":[]}]

# Trusted-wall kiosk user switching. OFF unless set to true/1. Enable ONLY on the household wall:
# when on, ANY authed allowlisted client at /?kiosk=1 can switch to any allowlisted user (bounded to
# the allowlist). Leave unset everywhere except the wall deploy.
# KIOSK_USER_SWITCH=true

# Vision ("Henry, look at this"): ON by default. Uncomment to disable the webcam capture path.
# VISION=false