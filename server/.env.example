# Copy to .env and fill in. dev.sh loads this.
GOOGLE_API_KEY=...      # Gemini (reflex + brain)
CARTESIA_API_KEY=...    # speech-to-text (Ink-2) + text-to-speech (Sonic)
PORT=8787               # dev server port
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VOYAGE_API_KEY=         # used for embedding/vectors

# Authentik OIDC — server sign-in identity (who you are), separate from the Google OAuth
# above (a connector: what you granted access to). See docs/superpowers/specs/
# 2026-09-05-authentik-identity-design.md §3 for the Authentik console setup.
OIDC_ISSUER=            # e.g. https://auth.example.com/application/o/your-app-slug/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=      # e.g. http://localhost:8787/auth/oidc/callback

# Vector store (Unified Search / semantic memory). Local dev: run Qdrant via docker
# (`docker run -p 6333:6333 qdrant/qdrant:v1.18.2`) or the compose service.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=            # set the same value on the qdrant service in prod

# Instance timezone (IANA name) — grounds the assistant's relative-time reasoning and local-time
# display. Defaults to America/Chicago if unset; an invalid name falls back to that too.
TIMEZONE=America/Chicago

# Who can sign in (ordered JSON; first entry is the primary who owns pre-existing connections).
# `aliases` is optional — other Google addresses that map to the same person.
ALLOWED_USERS=[{"email":"you@example.com","name":"You","aliases":[]}]

# Named household targets: lets a tool call write to another allowlisted member's reminders,
# lists or garden by name ("remind Sarah to…"). OFF unless set to true/1.
# HOUSEHOLD_NAMED_TARGETS=true

HOME_ASSISTANT_URL=https://YOUR-INSTANCE.ui.nabu.casa
HOME_ASSISTANT_TOKEN=

# Claude dispatch (Henry starts Claude Code jobs on forge issues). FORGE_URL + FORGE_TOKEN turn
# the repos toolkit on; CLAUDE_DISPATCH=false switches it off again. DISPATCH_REPO defaults to
# kalcode/claude-dispatch. CLAUDE_DISPATCH_USERS is comma-separated canonical emails.
# FORGE_URL is the API base: the forge's LAN address, so API POSTs skip Cloudflare's browser
# check. FORGE_PUBLIC_URL is the base of every link Henry hands you (ntfy Click, issue and run
# links); unset, links use FORGE_URL.
# FORGE_URL=http://192.168.50.249:3000
# FORGE_PUBLIC_URL=https://code.clausens.cloud
# FORGE_TOKEN=
# DISPATCH_REPO=kalcode/claude-dispatch
# DISPATCH_CALLBACK_SECRET is required to start jobs: without it every callback is refused, so
# start_claude refuses too (and boot logs a warning).
# DISPATCH_CALLBACK_SECRET=
# CLAUDE_DISPATCH_USERS=you@example.com
# ntfy phone pushes: NTFY_TOPIC turns them on; NTFY_URL defaults to https://ntfy.sh when unset
# or empty; NTFY_TOKEN only for a protected topic.
# NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# CLAUDE_DISPATCH=false
